OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Opt in only for local development; production rejects mock mode.
POVI_MOCK_MODE=false

# Provider is selected only by the backend. OpenAI remains the default.
LLM_PROVIDER=openai
OLLAMA_MODEL=llama3.2:3b
